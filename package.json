{
  "name": "clementine-wp-starter",
  "version": "1.0.0",
  "description": "handles root level lint operations and easy access to theme and plugin servers",
  "author": "Clementine",
  "license": "ISC",
  "main": "eslint.config.js",
  "type": "module",
  "scripts": {
    "plugin": "cd content/plugins/clementine-blocks && npm start",
    "plugin:build": "cd content/plugins/clementine-blocks && npm install && npm run build",
    "theme": "cd content/themes/clementine && npm run dev",
    "theme:build": "cd content/themes/clementine && npm install && npm run build",
    "lint:css": "stylelint \"**/*.scss\" --max-warnings=0",
    "format:js": "prettier \"**/*.js\" --max-warnings=0"
  },
  "devDependencies": {
    "@wordpress/eslint-plugin": "^23.0.0",
    "@wordpress/prettier-config": "^4.37.0",
    "@wordpress/stylelint-config": "^23.29.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "stylelint": "^16.26.1",
    "stylelint-scss": "^6.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jo-Ry/clementine-wordpress-boilerplate-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Jo-Ry/clementine-wordpress-boilerplate-theme/issues"
  },
  "homepage": "https://github.com/Jo-Ry/clementine-wordpress-boilerplate-theme#readme"
}
