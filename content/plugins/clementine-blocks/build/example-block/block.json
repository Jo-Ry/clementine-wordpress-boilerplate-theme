{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clementine-blocks/example-block",
  "version": "0.1.0",
  "title": "Example block",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with 'npm run create-block'",
  "attributes": {
    "name": {
      "type": "string",
      "default": "Haley"
    }
  },
  "example": {},
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "clementine",
  "editorScript": [
    "file:..\\runtime.js",
    "file:./index.js"
  ],
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": [
    "file:..\\runtime.js",
    "file:./view.js"
  ]
}